<?xml version="1.0" encoding="utf-8"?>
<!--
    Page 2 du dashboard — Climatisation (old-SDK uniquement : SWI133/68/165).
    Carte 1 : Consigne de température (slider) + Ventilation (slider)
    Carte 2 : Marche/arrêt, A/C, AUTO | Recirculation (3 choix) | Dégivrages
    Les bornes des sliders sont fixées par le code d'après getMinTemp/getMaxTemp et
    getMinAirVolume/getMaxAirVolume — les valeurs XML ne sont qu'un repli d'affichage.
    La page n'est PAS créée sur A9 (adapter : getItemCount) faute d'AirConditionManager.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dash_bg"
    android:padding="12dp">

    <!-- ══════════════════════════════════════════════════════════════════ -->
    <!--  CARTE : Température + Ventilation                                -->
    <!-- ══════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_card_rounded"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clim_card_title"
            android:textColor="@color/dash_text_lo"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:textAllCaps="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="7dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/dash_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- ── Consigne de température ─────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_section_rounded"
                android:padding="9dp"
                android:layout_marginBottom="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/clim_temperature"
                        android:textColor="@color/dash_text_lo"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/clim_temp_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--°"
                        android:textColor="@color/dash_accent"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/clim_temp_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="16"
                    android:valueTo="32"
                    android:value="22"
                    android:stepSize="1"
                    app:labelBehavior="gone"
                    app:thumbRadius="14dp"
                    app:trackHeight="10dp"
                    app:thumbColor="@color/dash_accent"
                    app:trackColorActive="@color/dash_accent"
                    app:trackColorInactive="@color/dash_border" />

            </LinearLayout>

            <!-- ── Ventilation ─────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_section_rounded"
                android:padding="9dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/clim_fan"
                        android:textColor="@color/dash_text_lo"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/clim_fan_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/dash_accent"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/clim_fan_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="1"
                    android:valueTo="10"
                    android:value="1"
                    android:stepSize="1"
                    app:labelBehavior="gone"
                    app:thumbRadius="14dp"
                    app:trackHeight="10dp"
                    app:thumbColor="@color/dash_accent"
                    app:trackColorActive="@color/dash_accent"
                    app:trackColorInactive="@color/dash_border" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════════════════ -->
    <!--  CARTE : Interrupteurs | Recirculation | Dégivrages               -->
    <!-- ══════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_card_rounded">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clim_modes_title"
            android:textColor="@color/dash_text_lo"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:textAllCaps="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="7dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/dash_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:padding="10dp">

            <!-- ── Colonne 1 : Marche / A-C / AUTO ─────────────────── -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_section_rounded"
                android:padding="9dp"
                android:layout_marginEnd="5dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/clim_section_switches"
                    android:textColor="@color/dash_text_lo"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/clim_power"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <Switch
                        android:id="@+id/clim_switch_power"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/clim_ac"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <Switch
                        android:id="@+id/clim_switch_ac"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/clim_auto"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <Switch
                        android:id="@+id/clim_switch_auto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </LinearLayout>

            <!-- ── Colonne 2 : Recirculation ───────────────────────── -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_section_rounded"
                android:padding="9dp"
                android:layout_marginEnd="5dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/clim_section_loop"
                    android:textColor="@color/dash_text_lo"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clim_btn_loop_inner"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="4dp"
                    android:text="@string/clim_loop_inner"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    app:backgroundTint="@color/dash_btn"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/dash_border"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clim_btn_loop_outside"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="4dp"
                    android:text="@string/clim_loop_outside"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    app:backgroundTint="@color/dash_btn"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/dash_border"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clim_btn_loop_auto"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="@string/clim_loop_auto"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    app:backgroundTint="@color/dash_btn"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/dash_border"
                    app:cornerRadius="8dp" />

            </LinearLayout>

            <!-- ── Colonne 3 : Dégivrages ──────────────────────────── -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_section_rounded"
                android:padding="9dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/clim_section_defrost"
                    android:textColor="@color/dash_text_lo"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/clim_defrost_front"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <Switch
                        android:id="@+id/clim_switch_defrost_front"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- Dégivrage arrière retiré : non exposé par ce véhicule (testé SWI133). -->

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
