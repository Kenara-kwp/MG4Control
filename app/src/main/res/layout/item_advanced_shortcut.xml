<?xml version="1.0" encoding="utf-8"?>
<!-- Une ligne de la liste des raccourcis avancés : touche, type d'appui, action, suppression.
     Une même touche peut apparaître deux fois, une par type d'appui. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_section_rounded"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/adv_item_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/adv_item_press"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/dash_text_lo"
            android:textSize="13sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/adv_item_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="14dp"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <!-- Sans suppression, un raccourci enregistré par erreur serait définitif. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/adv_item_delete"
        android:layout_width="72dp"
        android:layout_height="52dp"
        android:text="@string/adv_sc_delete"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:backgroundTint="@color/dash_btn"
        app:strokeWidth="1dp"
        app:strokeColor="@color/dash_border"
        app:cornerRadius="8dp"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

</LinearLayout>
